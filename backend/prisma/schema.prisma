generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
}

enum Role {
  SENIOR
  FAMILY
  VOLUNTEER
  ADMIN
}

model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  phone         String?
  email         String    @unique
  password      String
  name          String
  role          Role      @default(SENIOR)
  status        AccountStatus @default(ACTIVE)
  avatar        String?
  age           Int?
  city          String?
  locality      String?
  latitude      Float?
  longitude     Float?
  languages     String[]
  bio           String?
  verified      Boolean   @default(false)
  showAge       Boolean   @default(true)
  showLocation  Boolean   @default(true)
  showInterests Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  eventReminder String    @default("1_DAY") // 1_DAY, 1_HOUR, NONE

  // Many-to-many Hobbies (MongoDB style)
  hobbyIds      String[]  @db.ObjectId
  hobbies       Hobby[]   @relation(fields: [hobbyIds], references: [id])

  // Many-to-many Activities (MongoDB style)
  activityIds   String[]  @db.ObjectId
  activities    Activity[] @relation(fields: [activityIds], references: [id])

  // Connections
  connections   Connection[] @relation("UserConnections")
  connectedTo   Connection[] @relation("ConnectedUsers")

  // Messages
  sentMessages      Message[] @relation("SentMessages")
  receivedMessages  Message[] @relation("ReceivedMessages")

  notifications Notification[]

  reminders     Reminder[]
  emergencies   EmergencyAlert[]

  // Blocks
  blockedUsers  Block[] @relation("Blocker")
  blockedBy     Block[] @relation("Blocked")

  // Reports
  reportsSubmitted Report[] @relation("Reporter")
  reportsReceived  Report[] @relation("ReportedUser")

  // Events
  createdEvents    Event[]  @relation("EventCreator")
  eventParticipations EventParticipant[]
  savedEvents      SavedEvent[]
  eventMessages    EventMessage[]

  @@index([createdAt])
}

model Hobby {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String   @unique
  userIds   String[] @db.ObjectId
  users     User[]   @relation(fields: [userIds], references: [id])
}

model Connection {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  user        User     @relation("UserConnections", fields: [userId], references: [id])
  connectedId String   @db.ObjectId
  connected   User     @relation("ConnectedUsers", fields: [connectedId], references: [id])
  status      String   @default("PENDING") // PENDING, ACCEPTED, BLOCKED
  createdAt   DateTime @default(now())

  @@index([userId, status])
  @@index([connectedId, status])
}

model Message {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  senderId    String   @db.ObjectId
  sender      User     @relation("SentMessages", fields: [senderId], references: [id])
  receiverId  String   @db.ObjectId
  receiver    User     @relation("ReceivedMessages", fields: [receiverId], references: [id])
  content     String
  createdAt   DateTime @default(now())

  @@index([senderId, receiverId])
  @@index([receiverId, senderId])
  @@index([createdAt])
}

model Notification {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  userId              String   @db.ObjectId
  user                User     @relation(fields: [userId], references: [id])
  type                String   // NEW_CONNECTION_REQUEST, CONNECTION_ACCEPTED, NEW_MESSAGE
  title               String
  message             String
  relatedUserId       String?  @db.ObjectId
  relatedConnectionId String?  @db.ObjectId
  relatedMessageId    String?  @db.ObjectId
  relatedEventId      String?  @db.ObjectId
  isRead              Boolean  @default(false)
  createdAt           DateTime @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@index([userId, relatedEventId, type, title])
}

model Activity {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  category    String
  description String
  location    String
  latitude    Float?
  longitude   Float?
  startTime   DateTime
  image       String?
  organizerId String   @db.ObjectId
  createdAt   DateTime @default(now())
  
  participantIds String[] @db.ObjectId
  participants   User[]   @relation(fields: [participantIds], references: [id])
}

model Reminder {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  user        User     @relation(fields: [userId], references: [id])
  title       String
  type        String   // MEDICINE, EVENT, WATER
  time        DateTime
  completed   Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model EmergencyAlert {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  user        User     @relation(fields: [userId], references: [id])
  latitude    Float?
  longitude   Float?
  status      String   @default("ACTIVE") // ACTIVE, RESOLVED
  createdAt   DateTime @default(now())
}

model Block {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  blockerId   String   @db.ObjectId
  blocker     User     @relation("Blocker", fields: [blockerId], references: [id])
  blockedId   String   @db.ObjectId
  blocked     User     @relation("Blocked", fields: [blockedId], references: [id])
  createdAt   DateTime @default(now())

  @@unique([blockerId, blockedId])
}

model Report {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  reporterId      String   @db.ObjectId
  reporter        User     @relation("Reporter", fields: [reporterId], references: [id])
  reportedUserId  String   @db.ObjectId
  reportedUser    User     @relation("ReportedUser", fields: [reportedUserId], references: [id])
  reason          String
  description     String?
  status          String   @default("PENDING") // PENDING, REVIEWED, RESOLVED, DISMISSED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([createdAt])
}

model Event {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  title           String
  description     String
  category        String
  location        String
  latitude        Float?
  longitude       Float?
  date            DateTime
  startTime       String
  endTime         String
  maxParticipants Int
  status          String   @default("ACTIVE") // ACTIVE, CANCELLED
  
  createdById     String   @db.ObjectId
  creator         User     @relation("EventCreator", fields: [createdById], references: [id])
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  participants    EventParticipant[]
  savedBy         SavedEvent[]
  messages        EventMessage[]

  removedAt       DateTime?
  removedById     String?  @db.ObjectId

  @@index([status, date])
  @@index([category, status])
  @@index([createdById])
  @@index([createdAt])
}

model EventParticipant {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  eventId   String   @db.ObjectId
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt  DateTime @default(now())

  @@unique([eventId, userId])
}

model SavedEvent {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  eventId   String   @db.ObjectId
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  savedAt   DateTime @default(now())

  @@unique([eventId, userId])
}

model EventMessage {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  eventId   String   @db.ObjectId
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  senderId  String   @db.ObjectId
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())

  @@index([eventId, createdAt])
}
